// Pin: openclaw/VERSION (2026.10.5, CLI 1b58cb9). Merge into ~/.openclaw/openclaw.json.
{
  session: {
    dmScope: "per-channel-peer",
    groupScope: "per-group",
  },
  // Install the local embedding provider first; see openclaw/README.md.
  memory: {
    search: {
      provider: "local",
      fallback: "none",
      sources: ["memory"],
      local: {
        modelPath: "hf:ggml-org/embeddinggemma-300m-qat-q8_0-GGUF/embeddinggemma-300m-qat-Q8_0.gguf",
      },
    },
  },
  agents: {
    defaults: {
      skipBootstrap: true,
      timeoutSeconds: 1800,
      compaction: {
        memoryFlush: { enabled: true },
      },
      heartbeat: {
        every: "30m",
        target: "none",
        timeoutSeconds: 900,
        lightContext: false,
        isolatedSession: false,
        prompt: "On the live main checkout, run `bun scripts/sync-workspace.ts` once. Load due work with `bun scripts/heartbeat-state.ts due` and fetch GitHub notifications once. Handle due items and notifications with skills/routine-maintainer (rules/safety.md). Recurring full sync and the Friday report are automations — do not invent them from chat history. If nothing needs attention, call heartbeat_respond with notify=false, or reply NO_REPLY.",
      },
    },
    entries: {
      main: {
        workspace: "/absolute/path/to/albert-workspace",
        identity: { name: "Albert" },
      },
    },
  },
  cron: {
    enabled: true,
  },
  plugins: {
    entries: {
      "memory-core": {
        config: {
          dreaming: {
            enabled: true,
            timezone: "Europe/Paris",
            frequency: "0 3 * * *",
          },
        },
      },
    },
  },
}
